+            }
+        }
+    } finally {$GLOBALS['cwp_config']['db']['prefix']=$originalPrefix;}
+    return ['scope'=>'Actual native schema validators and original-query multiset equivalence','families'=>$families,'legacy_and_checkout'=>true,'cross_schema_executed'=>$foreign!==null,'named_checks'=>count($checks)-$before,'observations'=>array_slice($fkm_observations,$observedBefore),'source_sha256'=>array_map(static fn(string $path):string=>hash_file('sha256',$path),$sources),'query_sha256'=>array_map(static fn(string $sql):string=>hash('sha256',$sql),$queries),'original_query_sha256'=>hash('sha256',FKM_ORIGINAL),'database_version'=>$identity['version']];
+}
