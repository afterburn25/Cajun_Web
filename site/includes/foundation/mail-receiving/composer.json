{
  "name": "cajunwebpro/mail-receiving-runtime",
  "description": "Pinned runtime dependencies for the bounded CajunWebPro inbox adapter",
  "type": "project",
  "require": {
    "directorytree/imapengine": "1.25.6",
    "symfony/html-sanitizer": "7.4.20",
    "zbateson/mail-mime-parser": "4.0.6"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": false,
    "sort-packages": true,
    "bin-compat": "full"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
