# Apache 2.4 / LiteSpeed. Explicit PHP routes work without mod_rewrite.
Options -Indexes
DirectoryIndex index.php
<FilesMatch "^(config\.php|config-pending-.*\.php|\.installed\.php|\.installation-mutex\.php|\.structure-.*|install-key\.php|proxy-config\.php)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^robots\.txt$ api/robots.php [L]
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
  RewriteRule ^api/validate$ api/validate.php [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
